# 带上旗帜后，如果声誉高于-100，则可以暂时加入该阵营
execute as @a if items entity @s armor.head white_banner[custom_name="灾厄旗帜",rarity=epic,equippable={slot:"head"},banner_patterns=[{color:"cyan", pattern:"minecraft:rhombus"},{color:"light_gray", pattern:"minecraft:stripe_bottom"},{color:"gray", pattern:"minecraft:stripe_center"},{color:"light_gray",pattern:"minecraft:border"},{color:"black", pattern:"minecraft:stripe_middle"},{color:"light_gray", pattern:"minecraft:half_horizontal"},{color:"light_gray", pattern:"minecraft:circle"},{color:"black", pattern:"minecraft:border"}]] if score @s reputation_in_illager matches -100.. run team join illager_party @s
execute as @a if items entity @s armor.head yellow_banner[custom_name="蛮荒旗帜",rarity=epic,equippable={slot:"head"},banner_patterns=[{color:"red", pattern:"minecraft:curly_border"},{color:"orange", pattern:"minecraft:gradient"},{color:"red", pattern:"minecraft:circle"},{color:"red",pattern:"minecraft:small_stripes"},{color:"yellow", pattern:"minecraft:piglin"},{color:"orange", pattern:"minecraft:triangles_top"}]] if score @s reputation_in_piglin matches -100.. run team join piglin_party @s
execute as @a if items entity @s armor.head gray_banner[custom_name="死亡旗帜",rarity=epic,equippable={slot:"head"},banner_patterns=[{color:"green", pattern:"minecraft:curly_border"},{color:"light_gray", pattern:"minecraft:bricks"},{color:"black", pattern:"minecraft:rhombus"},{color:"black",pattern:"minecraft:flower"},{color:"white", pattern:"minecraft:skull"}]] if score @s reputation_in_undead matches -100.. run team join undead-arthropod_party @s
execute as @a[team=undead-arthropod_party] unless score @s reputation_in_undead matches -100.. run team leave @s
execute as @a[team=illager_party] unless score @s reputation_in_illager matches -100.. run team leave @s
execute as @a[team=piglin_party] unless score @s reputation_in_piglin matches -100.. run team leave @s
execute as @a[team=undead-arthropod_party] unless items entity @s armor.head gray_banner[custom_name="死亡旗帜",rarity=epic,equippable={slot:"head"}] run team leave @s
execute as @a[team=illager_party] unless items entity @s armor.head white_banner[custom_name="灾厄旗帜",rarity=epic,equippable={slot:"head"}] run team leave @s
execute as @a[team=piglin_party] unless items entity @s armor.head yellow_banner[custom_name="蛮荒旗帜",rarity=epic,equippable={slot:"head"}] run team leave @s
execute as @a unless items entity @s armor.head #banners run team leave @s


